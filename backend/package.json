{
  "name": "jpo-airtable-backend",
  "version": "1.0.0",
  "description": "Fastify API backend for JPO Airtable project",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "bun ./server.js",
    "worker": "ts-node src/worker/airtableSync.worker.ts",
    "worker:prod": "bun ./dist/worker/airtableSync.worker.js",
    "server": "bun ./server.js"
  },
  "dependencies": {
    "@fastify/caching": "^9.0.3",
    "@fastify/compress": "^8.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "airtable": "^0.12.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.58.7",
    "dotenv": "^17.2.2",
    "fastify": "^5.6.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
